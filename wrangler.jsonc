{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "under-the-lights",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://under-the-lights.flobl.workers.dev"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "under-the-lights",
      "database_id": "331a4289-d938-43ee-95e2-445f1027837c",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 7 * * 1"]
  }
}
